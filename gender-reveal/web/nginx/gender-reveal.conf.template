# Serves the static export (`npm run build` → web/out) and proxies /api to Spring.
# Mount web/out at /usr/share/nginx/html. This file is an envsubst template (nginx's official
# image runs envsubst on every /etc/nginx/templates/*.template at container start) so the API
# upstream can differ per platform without a rebuild: docker-compose's API_HOST/API_PORT
# defaults (set in the Dockerfile) resolve to the `api` service; on a platform without
# docker-compose's DNS (e.g. Railway, where services are reached at
# `<service>.railway.internal`), override API_HOST/API_PORT via that platform's env vars.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    error_page 404 /404.html;

    # Cookie auth (SameSite=Lax) doesn't stop this page being framed and clickjacked into
    # driving real owner actions (extend/delete) — block framing outright.
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # Same-origin API: cookies (guest_id, owner_session) work without CORS.
    location /api/ {
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Every /g/<slug> gets the same static shell; the slug is read in the browser.
    location ~ ^/g/[^/]+/?$ {
        add_header Cache-Control "no-store";
        try_files /g.html =404;
    }

    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # /login, /dashboard, /create are plain static files (no dynamic path segment —
    # the dashboard reads ?slug=... client-side), so the default `location /` block
    # above already serves them; no extra rule needed (see Plan 5).
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
